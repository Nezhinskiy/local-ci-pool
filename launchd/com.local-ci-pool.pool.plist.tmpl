<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local-ci-pool.pool</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BIN@</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart after a crash or a Docker change (non-zero exit). A cause that
	     restarting cannot fix, such as a token GitHub refuses or a second pool,
	     makes the pool exit 0. A token gh cannot give is waited for in the
	     process, not exited on. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<!-- Asks for 45 minutes, but macOS clamps a LaunchAgent's exit timeout to
	     60 s, so this does not protect the drain: install.sh sends the pool
	     SIGTERM itself and waits for it before it unloads the agent. -->
	<key>ExitTimeOut</key>
	<integer>2700</integer>
	<!-- Standard, not Background. Background puts the pool and everything it
	     starts (gh, git) in darwinbg: the lowest CPU priority (4), throttled
	     disk and network I/O. On a Mac loaded far past its cores that starves
	     the pool, and its GitHub calls hit their 30 s timeout, heartbeats
	     included. Adaptive is the same as Background here: it lifts a job only
	     while an XPC transaction is open, and the pool has none. Standard runs at
	     priority 20, below apps and the Docker VM (31), so the jobs still come
	     first, and the coordinator itself is light. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>StandardOutPath</key>
	<string>@LOG_DIR@/pool.log</string>
	<key>StandardErrorPath</key>
	<string>@LOG_DIR@/pool.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- gh and git live under /opt/homebrew or /usr/local; scutil and ioreg
		     are in /usr/sbin. -->
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
